# Copia este archivo como .env (no se sube a git) y rellena los valores.

# Contraseña de PostgreSQL (larga y aleatoria)
POSTGRES_PASSWORD=

# Tu usuario de la zona privada: se crea la primera vez que arranca la API, y si cambias
# el usuario o la contraseña aquí, se actualizan al reiniciarla. Se entra con ADMIN_USUARIO.
ADMIN_USUARIO=
ADMIN_EMAIL=
# mínimo 12 caracteres (mejor una frase larga). Cambiarla aquí la aplica al reiniciar; si la cambias desde Perfil, no se deshace
ADMIN_PASSWORD=

# Contraseña del panel de registros Seq (http://localhost:5341)
SEQ_PASSWORD=

# Token del túnel de Cloudflare (Zero Trust > Networks > Tunnels > tu túnel > Docker)
CLOUDFLARE_TUNNEL_TOKEN=

# Tailscale (perfil «publico»): clave de autenticación de un solo uso
# (login.tailscale.com > Settings > Keys > Generate auth key). Solo hace falta la primera vez.
TS_AUTHKEY=

# Clave maestra que cifra en la base las notas, el portapapeles y las claves de servicios (AES-256). OBLIGATORIA.
# Genera una con: openssl rand -base64 32
# Guárdala TAMBIÉN fuera del PC (gestor de contraseñas): si se pierde, esos datos no se pueden recuperar ni con la copia de la base.
MDA_CLAVE_MAESTRA=

# PIN inicial de Documentos (cuatro cifras). Solo se usa la primera vez; después se cambia desde Seguridad y puedes borrar esta línea.
DOCUMENTOS_PIN_INICIAL=

# Token compartido con el agente de Windows (agente/Mda.Agente), que manda las métricas reales del PC.
# Mínimo 32 caracteres (con menos la ruta no existe). Genera uno con: openssl rand -hex 32
AGENTE_TOKEN=

# Seguridad de Documentos (opcional)
# MODO_<CARPETA>=ro deja esa carpeta de solo lectura (no se sube, renombra ni borra desde la app). Por defecto rw.
#   MODO_ESCRITORIO=ro   MODO_DESCARGAS=ro   MODO_IMAGENES=ro   MODO_MUSICA=ro   MODO_VIDEOS=ro   MODO_DOCUMENTOS=ro
# Por defecto no se pueden subir ni crear programas ni scripts (.exe, .bat, .ps1, .lnk…). true lo permite.
# PERMITIR_EJECUTABLES=false
# Nombres de host aceptados (cabecera Host), separados por «;». Por defecto: cualquier *.ts.net y localhost
# ALLOWED_HOSTS=equipo-de-casa.tu-red.ts.net;localhost;127.0.0.1;api

# Documentos: rutas de Windows de las carpetas que se ven en la zona privada (con / en vez de \)
CARPETA_DOCUMENTOS=C:/Users/tu-usuario/Documents
CARPETA_ESCRITORIO=C:/Users/tu-usuario/Desktop
CARPETA_DESCARGAS=C:/Users/tu-usuario/Downloads
CARPETA_IMAGENES=C:/Users/tu-usuario/Pictures
CARPETA_MUSICA=C:/Users/tu-usuario/Music
CARPETA_VIDEOS=C:/Users/tu-usuario/Videos

# Dirección pública de la app (la de Tailscale Funnel): con ella se forman las direcciones de vuelta de Spotify y Google
URL_PUBLICA=https://equipo-de-casa.tu-red.ts.net
ZONA_HORARIA=Europe/Madrid

# Avisos por correo (Gmail: smtp.gmail.com y una «contraseña de aplicación» de tu cuenta de Google)
CORREO_SERVIDOR=
CORREO_PUERTO=587
CORREO_USUARIO=
CORREO_CLAVE=
CORREO_PARA=

# Avisos por WhatsApp con CallMeBot (callmebot.com: te da una API key ligada a tu número)
WHATSAPP_TELEFONO=
WHATSAPP_APIKEY=
# Telegram: crea un bot con @BotFather (/newbot) y pega aquí su token; luego vincúlalo en Seguridad › Avisos
TELEGRAM_TOKEN=

# Spotify (developer.spotify.com/dashboard) y Google Calendar (console.cloud.google.com, ID de cliente OAuth «Aplicación web»)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Copias fuera del PC (herramientas/copias.sh): sin COPIAS_AGE_PUBLICA solo hay copia local.
# 1) Genera el par de claves con «age-keygen» (https://github.com/FiloSottile/age) y guarda la PRIVADA fuera del PC (gestor de contraseñas o USB).
# 2) Pon aqui la PUBLICA (empieza por age1...). 3) COPIAS_NUBE es una carpeta que ya sincronice OneDrive.
COPIAS_AGE_PUBLICA=
COPIAS_NUBE=C:/Users/tu-usuario/OneDrive/Copias-zona-privada

# Latido para Healthchecks.io (gratis): crea un check de 5 min con margen de 15 y pega aquí su URL de ping.
# Si el PC se apaga o se corta internet, te avisa por correo o Telegram.
HEALTHCHECK_URL=
