<Project Sdk="Microsoft.NET.Sdk">

  <!-- «Zona privada.exe»: arranca Docker y los contenedores, aloja el agente del PC y vive en la bandeja junto al reloj.
       Un solo ejecutable autocontenido (no hace falta tener .NET instalado) que pide permisos de administrador una vez. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ZonaPrivada</AssemblyName>
    <RootNamespace>Mda.Lanzador</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>icono.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting> <!-- compila también en Linux (integración continua) -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <Version>1.2.0</Version>
  </PropertyGroup>

  <!-- El mismo agente que el de consola, sin duplicar código -->
  <ItemGroup>
    <Compile Include="..\..\agente\Mda.Agente\AgenteServicio.cs" Link="Agente\AgenteServicio.cs" />
    <Compile Include="..\..\agente\Mda.Agente\Salud.cs" Link="Agente\Salud.cs" />
    <Compile Include="..\..\agente\Mda.Agente\Ordenes.cs" Link="Agente\Ordenes.cs" />
    <Compile Include="..\..\agente\Mda.Agente\Dispositivos.cs" Link="Agente\Dispositivos.cs" />
    <Compile Include="..\..\agente\Mda.Agente\Vigias.cs" Link="Agente\Vigias.cs" />
    <Compile Include="..\..\agente\Mda.Agente\PaqueteMagico.cs" Link="Agente\PaqueteMagico.cs" />
    <Compile Include="..\..\agente\Mda.Agente\Energia.cs" Link="Agente\Energia.cs" />
    <Compile Include="..\..\agente\Mda.Agente\Limpieza.cs" Link="Agente\Limpieza.cs" />
    <Compile Include="..\..\agente\Mda.Agente\InformeBateria.cs" Link="Agente\InformeBateria.cs" />
    <Compile Include="..\..\agente\Mda.Agente\Termica.cs" Link="Agente\Termica.cs" />
    <Compile Include="..\..\agente\Mda.Agente\Abrir.cs" Link="Agente\Abrir.cs" />
    <Compile Include="..\..\agente\Mda.Agente\Velocidad.cs" Link="Agente\Velocidad.cs" />
    <Compile Include="..\..\agente\Mda.Agente\CapturaLogica.cs" Link="Agente\CapturaLogica.cs" />
    <Compile Include="..\..\agente\Mda.Agente\Captura.cs" Link="Agente\Captura.cs" />
    <Compile Include="..\..\agente\Mda.Agente\DescargaLogica.cs" Link="Agente\DescargaLogica.cs" />
    <Compile Include="..\..\agente\Mda.Agente\Descargas.cs" Link="Agente\Descargas.cs" />
    <Compile Include="..\..\agente\Mda.Agente\UbicacionLogica.cs" Link="Agente\UbicacionLogica.cs" />
    <Compile Include="..\..\agente\Mda.Agente\Ubicacion.cs" Link="Agente\Ubicacion.cs" />
    <Compile Include="..\..\api\Mda.Api\Sistema\LectorSistema.cs" Link="Agente\LectorSistema.cs" />
    <PackageReference Include="System.Management" Version="10.0.14" />
  </ItemGroup>

</Project>
